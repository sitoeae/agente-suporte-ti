# ---------------------------------------------------------
# Variáveis de ambiente do frontend
# Copia este ficheiro para .env e preenche os valores.
# NUNCA comitas o .env real.
# ---------------------------------------------------------

# URL do backend (FastAPI). Em desenvolvimento local:
VITE_API_URL=http://localhost:8000

# URL do Supabase (fase 2/3)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Fase 3: se o chat usar IA diretamente do frontend
# (NÃO recomendado em produção — a chave deve ficar no backend)
# VITE_AI_PROVIDER=
# VITE_AI_MODEL=